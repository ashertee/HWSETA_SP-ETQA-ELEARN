                <field name="broken"/>
                <field name="stat_msg"/>
            </list>
        </field>
    </record>

    <record id="action_update_provider_info_admin_form" model="ir.actions.act_window">
    <field name="name">Fix Providers</field>
    <field name="res_model">update.provider</field>
    <field name="view_mode">form</field>
    <field name="view_id" ref="hwseta_etqe.update_provider_info_admin_form"/>
    <field name="target">new</field>
</record>

<record id="seta_nlrd_21_form_view" model="ir.ui.view">
    <field name="name">SETA nlrd.exporter Wizard</field>
    <field name="model">nlrd.21</field>
    <field name="arch" type="xml">
        <form create="false" string="NLRD 21">
            <header>
                <button name="%(action_update_provider_info_admin_form)d"
                        type="action"
                        string="Fix this Provider"
                        context="{'provider_id': provider_id}"
                        class="btn-primary"/>
            </header>
            <sheet>
                <group>
                <group>
                    <field name="Provider_Type_Id"/>
                    <field name="Provider_Class_Id"/>
                    <field name="Provider_Contact_Name"/>
                    <field name="Longitude_Minutes"/>
                    <field name="Std_Industry_Class_Code"/>
                    <field name="provider_id"/>
                    <field name="Provider_Accreditation_Num"/>
                    <field name="Etqa_Id"/>
                    <field name="Country_Code"/>
                    <field name="Longitude_Degree"/>
                    <field name="Provider_Accredit_Start_Date"/>
                    <field name="Provider_Fax_Number"/>
                    <field name="Province_Code"/>
                    <field name="Provider_Phone_Number"/>
                    <field name="Provider_Contact_Cell_Number"/>
                    <field name="Provider_Physical_Address_2"/>
                    <field name="Provider_Contact_Phone_Number"/>
                    <field name="Date_Stamp"/>
                    <field name="Provider_Physical_Address_1"/>
                    <field name="Provider_Postal_Code"/>
                </group>
                <group>
                    <field name="Provider_Name"/>
                    <field name="Provider_Physical_Address_Town"/>
                    <field name="Provider_Accredit_End_Date"/>
                    <field name="Latitude_Seconds"/>
                    <field name="Structure_Status_Id"/>
                    <field name="Etqa_Decision_Number"/>
                    <field name="broken" string="Broken"/>
                    <field name="Provider_Phys_Address_Postcode"/>
                    <field name="Provider_Address_1"/>
                    <field name="Provider_Address_2"/>
                    <field name="Provider_Address_3"/>
                    <field name="Provider_Code"/>
                    <field name="Longitude_Seconds"/>
                    <field name="Provider_Sars_Number"/>
                    <field name="Provider_Web_Address"/>
                    <field name="Provider_Contact_Email_Address"/>
                    <field name="stat_msg" invisible="1"/>
                    <field name="Latitude_Minutes"/>
                    <field name="link_broken" string="Link Broken"/>
                    <field name="Latitude_Degree"/>
                </group>
                </group>
            </sheet>
        </form>
    </field>
</record>

