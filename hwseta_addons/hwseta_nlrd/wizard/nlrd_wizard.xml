                <field name="stat_msg"/>
            </list>
        </field>
    </record>

    <record id="action_nlrd_25_tree" model="ir.actions.act_window">
        <field name="name">NLRD 25</field>
        <field name="res_model">nlrd.25</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_nlrd_25"
              name="NLRD 25 person"
              action="action_nlrd_25_tree"
              parent="menu_nlrd_sub"/>


    <!-- NLRD 26 -->
    <record id="view_nlrd_26_tree" model="ir.ui.view">
        <field name="name">nlrd.26.tree</field>
        <field name="model">nlrd.26</field>
        <field name="arch" type="xml">
            <list decoration-danger="broken == True">
                <field name="National_Id"/>
                <field name="broken"/>
                <field name="stat_msg"/>
            </list>
        </field>
    </record>

    <record id="action_nlrd_26_tree" model="ir.actions.act_window">
        <field name="name">NLRD 26</field>
        <field name="res_model">nlrd.26</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_nlrd_26"
              name="NLRD 26 assessor"
              action="action_nlrd_26_tree"
              parent="menu_nlrd_sub"/>


    <!-- NLRD 27 -->
    <record id="view_nlrd_27_tree" model="ir.ui.view">
        <field name="name">nlrd.27.tree</field>
        <field name="model">nlrd.27</field>
        <field name="arch" type="xml">
            <list decoration-danger="broken == True">
                <field name="Qualification_Id"/>
                <field name="broken"/>
                <field name="stat_msg"/>
            </list>
        </field>
    </record>

    <record id="action_nlrd_27_tree" model="ir.actions.act_window">
        <field name="name">NLRD 27</field>
        <field name="res_model">nlrd.27</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_nlrd_27"
              name="NLRD 27 assessor quals"
              action="action_nlrd_27_tree"
              parent="menu_nlrd_sub"/>


    <!-- NLRD 29 -->
    <record id="view_nlrd_29_tree" model="ir.ui.view">
        <field name="name">nlrd.29.tree</field>
        <field name="model">nlrd.29</field>
        <field name="arch" type="xml">
            <list decoration-danger="broken == True">
                <field name="national_id"/>
                <field name="broken"/>
                <field name="stat_msg"/>
            </list>
        </field>
    </record>

    <record id="action_nlrd_29_tree" model="ir.actions.act_window">
        <field name="name">NLRD 29</field>
        <field name="res_model">nlrd.29</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_nlrd_29"
              name="NLRD 29 lrq"
              action="action_nlrd_29_tree"
              parent="menu_nlrd_sub"/>


    <!-- REPORT MENU -->
    <record id="view_nlrd_report_tree" model="ir.ui.view">
        <field name="name">nlrd.report.tree</field>
        <field name="model">nlrd.report</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="action_nlrd_report_tree" model="ir.actions.act_window">
        <field name="name">NLRD Report</field>
        <field name="res_model">nlrd.report</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_nlrd_report"
              name="NLRD report"
              action="action_nlrd_report_tree"
              parent="menu_nlrd_sub"/>


    <!-- EXPORTER MENUS -->
    <menuitem id="menu_nlrd_exporter"
              name="NLRD exporter"
              action="action_nlrd_exporter"
              parent="menu_nlrd_sub"/>

    <menuitem id="menu_nlrd_exporter2"
              name="NLRD exporter v2"
              action="action_nlrd_exporter2"
              parent="menu_nlrd_sub"/>

</odoo>
