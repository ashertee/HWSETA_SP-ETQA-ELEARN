<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ROOT MENU -->
    <menuitem id="menu_nlrd_root" name="NLRD" parent="hwseta_etqe.etqe_main_menu" groups="hwseta_nlrd.group_nlrd_admin"/>
    <menuitem id="menu_nlrd_sub" name="NLRD" parent="menu_nlrd_root"/>

    <record id="view_nlrd_config_tree" model="ir.ui.view">
    <field name="name">nlrd.config.tree</field>
    <field name="model">nlrd.config</field>
    <field name="arch" type="xml">
        <list string="NLRD Configuration" create="false">
            <field name="start"/>
            <field name="end"/>
            <field name="dat_files_attachment"/>
            <field name="id" string="Status" widget="badge"
                   decoration-success="start and end"
                   decoration-warning="not start or not end"/>
        </list>
    </field>
</record>


    <record id="view_nlrd_config_form" model="ir.ui.view">
    <field name="name">nlrd.config.form</field>
    <field name="model">nlrd.config</field>
    <field name="arch" type="xml">
        <form string="NLRD Configuration" create="false">
            <sheet>
                <div class="oe_title">
                    <h1>
                        <field name="name" readonly="1"/>
                    </h1>
                </div>

                <group>
                    <group name="date_range" string="Reporting Period">
                        <field name="start"/>
                        <field name="end"/>
                    </group>

                    <group name="files" string="Generated Documents">
                        <field name="dat_files_attachment"
                               widget="many2many_binary"
                               string="DAT Files"
                               options="{'no_create': True}"/>
                    </group>
                </group>
            </sheet>
        </form>
    </field>
</record>


    <!-- NLRD CONFIG ACTION -->
    <record id="action_nlrd_config_open" model="ir.actions.server">
    <field name="name">Open NLRD Configuration</field>
    <field name="model_id" ref="model_nlrd_config"/>
    <field name="state">code</field>
    <field name="code">
action = env['nlrd.config'].get_singleton().action_open_nlrd_config()
    </field>
</record>


    <menuitem id="menu_nlrd_config"
              name="NLRD Config"
              parent="menu_nlrd_sub"
              action="action_nlrd_config_open"/>


    <!-- EXPORTER WIZARD VIEW -->
    <record id="seta_nlrd_exporter_view" model="ir.ui.view">
        <field name="name">SETA NLRD Exporter Wizard</field>
        <field name="model">nlrd.exporter</field>
        <field name="arch" type="xml">
            <form string="nlrd.exporter">
                <footer>
                    <footer>
    <button name="do_all" string="Do All" type="object" default_focus="1" class="btn-primary"/>

    <span class="text-muted mx-2">or</span>

    <button name="fetch_nlrd_21" string="Provider 21" type="object" class="btn-secondary"/>
    <button name="fetch_nlrd_24" string="Accreditation 24" type="object" class="btn-secondary"/>
    <button name="fetch_nlrd_25" string="Person 25" type="object" class="btn-secondary"/>
    <button name="fetch_nlrd_26" string="Assessor 26" type="object" class="btn-secondary"/>
    <button name="fetch_nlrd_27" string="Assessor Reg 27" type="object" class="btn-secondary"/>
    <button name="fetch_nlrd_29" string="LRQ 29" type="object" class="btn-secondary"/>

    <span class="text-muted mx-2">or</span>

    <button name="inverse_check" string="Inverse Cleanup" type="object" class="btn-secondary"/>

    <span class="text-muted mx-2">or</span>

    <button name="gen_all_dats" string="Generate All DATs" type="object" class="btn-secondary"/>
    <button name="gen_21" string="Generate 21" type="object" class="btn-secondary"/>
    <button name="gen_25" string="Generate 25" type="object" class="btn-secondary"/>

    <span class="text-muted mx-2">or</span>

    <button name="unlink_all" string="Unlink All" type="object" class="btn-danger"/>

    <button string="Cancel" class="btn-secondary" special="cancel" />
</footer>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_nlrd_exporter" model="ir.actions.act_window">
        <field name="name">SETA NLRD Exporter</field>
        <field name="res_model">nlrd.exporter</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="seta_nlrd_exporter_view"/>
        <field name="target">new</field>
    </record>


    <!-- EXPORTER V2 WIZARD -->
    <record id="seta_nlrd_exporterv2_view" model="ir.ui.view">
        <field name="name">nlrd.exporter2.form</field>
        <field name="model">nlrd.exporter2</field>
        <field name="arch" type="xml">
            <form string="NLRD Exporter V2">
                <sheet>
                    <div class="alert alert-info" role="alert">
                        <strong>Submission Process:</strong>
                        <ol class="mt-2">
                            <li>Click <strong>"Process All"</strong> to generate submission data.</li>
                            <li>Click <strong>"Report Link Issues"</strong> to identify broken links.</li>
                            <li>Check the lists for broken records and correct them at the <strong>Master Data</strong> level.</li>
                            <li>Click <strong>"Clear"</strong> to empty the database of newly created records.</li>
                            <li>Repeat until you have a clean submission data set.</li>
                            <li>When errors are resolved, click <strong>"Generate All DATs"</strong>.</li>
                            <li>Import the <strong>.dat</strong> files into EduKtiv software.</li>
                        </ol>
                    </div>

                    <group>
                        <group string="Primary Actions" name="primary_actions">
                            <button name="do_all_v2" string="Process All" type="object" class="btn-primary w-100 mb-2"/>
                            <button name="report_link_issues" string="Report Link Issues" type="object" class="btn-secondary w-100 mb-2"/>
                            <button name="gen_all_dats" string="Generate All DATs" type="object" class="btn-success w-100 mb-2"/>
                            <button name="unlink_all" string="Clear Data" type="object" class="btn-danger w-100"
                                    confirm="This will clear all newly created records. Are you sure?"/>
                        </group>
                        <group string="Maintenance &amp; Utilities" name="utility_actions">
                            <button name="enum_dat_attachment" string="Attach DATS" type="object" class="btn-outline-primary w-100 mb-2"/>
                            <button name="purge_dupe_lrq" string="Purge Dupe LRQ" type="object" class="btn-link w-100"/>
                            <button name="purge_dupe_lrq_foreign" string="Purge Dupe Foreign" type="object" class="btn-link w-100"/>
                            <button name="purge_dupe_lrq_no_cert" string="Purge Dupe No Cert" type="object" class="btn-link w-100"/>
                        </group>
                    </group>
                </sheet>
                <footer>
                    <button string="Close" class="btn-secondary" special="cancel" data-hotkey="x" />
                </footer>
            </form>
        </field>
    </record>

    <record id="action_nlrd_exporter2" model="ir.actions.act_window">
        <field name="name">SETA NLRD Exporter Two</field>
        <field name="res_model">nlrd.exporter2</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="seta_nlrd_exporterv2_view"/>
        <field name="target">new</field>
    </record>


    <!-- NLRD 21 PROVIDER -->
    <record id="view_nlrd_21_tree" model="ir.ui.view">
        <field name="name">nlrd.21.tree</field>
        <field name="model">nlrd.21</field>
        <field name="arch" type="xml">
            <list create="false" decoration-danger="broken == True">
                <field name="provider_id"/>
                <field name="Provider_Accreditation_Num"/>
