<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ROOT MENU -->
    <menuitem id="menu_nlrd_root" name="NLRD" groups="hwseta_nlrd.group_nlrd_admin"/>
    <menuitem id="menu_nlrd_sub" name="NLRD" parent="menu_nlrd_root"/>


    <!-- NLRD CONFIG ACTION -->
    <record id="action_nlrd_config" model="ir.actions.act_window">
        <field name="name">SETA NLRD Config</field>
        <field name="res_model">nlrd.config</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_nlrd_config"
              name="NLRD Config"
              parent="menu_nlrd_sub"
              action="action_nlrd_config"/>


    <!-- EXPORTER WIZARD VIEW -->
    <record id="seta_nlrd_exporter_view" model="ir.ui.view">
        <field name="name">SETA NLRD Exporter Wizard</field>
        <field name="model">nlrd.exporter</field>
        <field name="arch" type="xml">
            <form string="nlrd.exporter">
                <footer>
                    <button name="do_all" string="do all" type="object" class="btn-primary"/>
                    <button name="fetch_nlrd_21" string="provider 21" type="object" class="btn-primary"/>
                    <button name="fetch_nlrd_24" string="accreditation 24" type="object" class="btn-primary"/>
                    <button name="fetch_nlrd_25" string="person 25" type="object" class="btn-primary"/>
                    <button name="fetch_nlrd_26" string="assessor 26" type="object" class="btn-primary"/>
                    <button name="fetch_nlrd_27" string="assessor reg 27" type="object" class="btn-primary"/>
                    <button name="fetch_nlrd_29" string="lrq 29" type="object" class="btn-primary"/>
                    <button name="inverse_check" string="inverse cleanup" type="object" class="btn-primary"/>
                    <button name="gen_all_dats" string="generate all dats" type="object" class="btn-primary"/>
                    <button name="unlink_all" string="unlink all" type="object" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="oe_link"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_nlrd_exporter" model="ir.actions.act_window">
        <field name="name">SETA NLRD Exporter</field>
        <field name="res_model">nlrd.exporter</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="seta_nlrd_exporter_view"/>
        <field name="target">new</field>
    </record>


    <!-- EXPORTER V2 WIZARD -->
    <record id="seta_nlrd_exporterv2_view" model="ir.ui.view">
        <field name="name">SETA NLRD Exporter Two Wizard</field>
        <field name="model">nlrd.exporter2</field>
        <field name="arch" type="xml">
            <form string="nlrd.exporter2">
                <group>
                    <button name="enum_dat_attachment" string="Attach DATS" type="object" class="btn-primary"/>
                    <button name="do_all_v2" string="Process all" type="object" class="btn-primary"/>
                    <button name="report_link_issues" string="report_link_issues" type="object" class="btn-primary"/>
                    <button name="gen_all_dats" string="generate all dats" type="object" class="btn-primary"/>
                    <button name="purge_dupe_lrq" string="purge_dupe_lrq" type="object" class="btn-primary"/>
                    <button name="unlink_all" string="Clear" type="object" class="btn-primary"/>
                </group>

                <footer>
                    <button string="Cancel" special="cancel" class="oe_link"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_nlrd_exporter2" model="ir.actions.act_window">
        <field name="name">SETA NLRD Exporter Two</field>
        <field name="res_model">nlrd.exporter2</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="seta_nlrd_exporterv2_view"/>
        <field name="target">new</field>
    </record>


    <!-- NLRD 21 PROVIDER -->
    <record id="view_nlrd_21_tree" model="ir.ui.view">
        <field name="name">nlrd.21.tree</field>
        <field name="model">nlrd.21</field>
        <field name="arch" type="xml">
            <list decoration-danger="broken == True">
                <field name="provider_id"/>
                <field name="Provider_Accreditation_Num"/>
                <field name="Provider_Code"/>
                <field name="broken"/>
                <field name="stat_msg"/>
            </list>
        </field>
    </record>

    <record id="action_nlrd_21_tree" model="ir.actions.act_window">
        <field name="name">NLRD 21 provider</field>
        <field name="res_model">nlrd.21</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_nlrd_21"
              name="NLRD 21 provider"
              action="action_nlrd_21_tree"
              parent="menu_nlrd_sub"/>


    <!-- NLRD 24 -->
    <record id="view_nlrd_24_tree" model="ir.ui.view">
        <field name="name">nlrd.24.tree</field>
        <field name="model">nlrd.24</field>
        <field name="arch" type="xml">
