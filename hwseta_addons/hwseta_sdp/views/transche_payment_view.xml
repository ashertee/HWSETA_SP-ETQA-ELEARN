<?xml version="1.0" encoding="UTF-8"?>
<odoo>
	<data>
	
		<record id="transche_payment_form_view" model="ir.ui.view">
    <field name="name">transche.payment.form.view</field>
    <field name="model">transche.payment</field>
    <field name="arch" type="xml">
        <form string='Tranche Payment Configuration'>
            <sheet>
                <group string="Tranche Payment Configuration">
                    <group>
                        <field name='funding_year' required="1" options="{'no_create': True, 'no_open': True}"/>
                        <field name="project_type" required="1" options="{'no_create': True, 'no_open': True}"/>
                        <field name='project_id' required="1" options="{'no_create': True, 'no_open': True}"/>
                        <field name="category_type" options="{'no_create': True, 'no_open': True}"/>

                        <field name="category"
                               required="category_type in ['18.1', '18.2']"
                               readonly="category_type not in ['18.1', '18.2']"
                               options="{'no_create': True, 'no_open': True}"/>
                    </group>
                    <group>
                        <field name='name' readonly="1"/>
                        <field name='trigger_jv' required="1" domain="[('model', 'in', ['learning.programme', 'monitor.and.evaluate', 'provider.assessment'])]" widget="selection"/>
                        <field name='object_state_id' domain="[('model_id', '=', trigger_jv)]" invisible="1"/>
                        <field name='employed_unemployed' invisible="1"/>

                        <field name="no_of_tranche"
                               required="category_type == '18.1'"
                               invisible="category_type == '18.2'"/>
                        <field name="no_of_tranche_18_2"
                               required="category_type == '18.2'"
                               invisible="category_type == '18.1'"/>

                        <field name='disc_expense_acc' required="1" options="{'no_create': True, 'no_open': True}"/>
                    </group>
                </group>
                <notebook>
                    <page string="Fees Structure">
                        <group>
                            <field name="get_fees" invisible="1"/>
                            <button name="action_tranche_fees_structure" string="Get Fees" type="object"
                                    class="oe_highlight" icon="fa-download"
                                    groups="project.group_project_manager,hwseta_finance.group_cfo,account.group_account_manager"/>
                        </group>
                        <group>
                            <field name="tranche_fees_ids" nolabel="1">
                                <list string="Fees Structure" editable="bottom" create="0">
                                    <field name="fees_id" required="1" readonly="1"/>
                                    <field name="employee_type" required="1" readonly="1"/>
                                    <field name="tranche_type" required="1"/>
                                    <field name="percentage" avg="Total Percentage"/>
                                    <field name="tranche_payment_id" column_invisible="1"/>
                                </list>
                            </field>
                        </group>
                    </page>
                    <page string="Tranche Document">
                        <group>
                            <field name="tranche_document_ids" nolabel="1">
                                <list string="Tranche Document" editable="bottom" create="0">
                                    <field name="name" required="1"/>
                                    <field name="required" widget="boolean_toggle"/>
                                </list>
                            </field>
                        </group>
                    </page>
                </notebook>
            </sheet>
            <chatter/>
        </form>
    </field>
</record>
        
        <record id="transche_payment_list_view" model="ir.ui.view">
    <field name="name">transche.payment.list</field>
    <field name="model">transche.payment</field>
    <field name="arch" type="xml">
        <list string="Tranche Payment Configuration">
            <field name="name" decoration-bf="1"/>

            <field name="trigger_jv" widget="badge" decoration-info="1"/>

            <field name="project_type"/>
            <field name="project_id"/>

            <field name="create_date" optional="hide"/>
            <field name="write_date" optional="hide"/>
        </list>
    </field>
</record>
        
        <record id="transche_payment_search_view" model="ir.ui.view">
    <field name="name">transche.payment.search</field>
    <field name="model">transche.payment</field>
    <field name="arch" type="xml">
        <search string="Tranche Payment Configuration">
            <field name="name"/>
            <field name="trigger_jv"/>
            <field name="project_type"/>
            <field name="project_id"/>
            <field name="employed_unemployed"/>

            <filter string="Employed" name="employed" domain="[('category_type', '=', '18.1')]"/>
            <filter string="Unemployed" name="unemployed" domain="[('category_type', '=', '18.2')]"/>
            <separator/>
            <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>

            <group expand="0" string="Group By">
                <filter string="Project Type" name="group_by_project_type" context="{'group_by': 'project_type'}"/>
                <filter string="Project" name="group_by_project" context="{'group_by': 'project_id'}"/>
                <filter string="Trigger" name="group_by_trigger" context="{'group_by': 'trigger_jv'}"/>
            </group>
        </search>
    </field>
</record>

<record id="action_transche_payment" model="ir.actions.act_window">
    <field name="name">Tranche Payment Configuration</field>
    <field name="res_model">transche.payment</field>
    <field name="view_mode">list,form</field>
    <field name="search_view_id" ref="transche_payment_search_view"/>
    <field name="help" type="html">
        <p class="o_view_nocontent_smiling_face">
            Configure your Tranche Payment rules.
        </p>
        <p>
            Define how payments are triggered for different project categories and funding years.
        </p>
    </field>
</record>

<menuitem id="child_menu_transche_payment"
          name="Tranche Payment Configuration"
          parent="menu_sdp_project"
          action="action_transche_payment"
          sequence="5"/>
        
