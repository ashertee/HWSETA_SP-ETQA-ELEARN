<?xml version="1.0" encoding="UTF-8"?>
<openerp>
	<data>
		<record id="view_wsp_query_request_form" model="ir.ui.view">
			<field name="name">wsp.query.request.form</field>
			<field name="model">wsp.query.request</field>
			<field name="arch" type="xml">
				<form string="WSP Query Process">
					<header>
						<field name="query_state" widget="statusbar" statusbar_visible="requested,verified,approved,rejected" />
						<field name="state" widget="statusbar" invisible="1"/>
						
					</header>
					<field name="submittable" invisible="1"/>
					<field name="query_allowed" invisible="1"/>
					<field name="is_tep_loaded" invisible="1" />
					<field name="is_tep_to_planned_loaded" invisible="1" />
					<field name="is_prev_wsp_loaded" invisible="1" />
					<field name="allow_query" invisible="1" />

					<group string="Organisation Details">
					<field name="wsp_id" string="WSP" readonly="1" options="{'no_create': True,'no_quick_create':True,'no_open':True}" />
						<group>
							<field name="sdf_id" readonly="1"/>
						</group>
						<group>
							<field name="user_id" invisible="1" />
							<field name="current_user_forbidden" invisible="1" />
						</group>
						<group>
							<field name="employer_id" readonly="1"/>
							<field name="fiscal_year" readonly="1" />
							<field name="wsp_start_period" invisible="1" />
							<field name="start_period" invisible="1" />
							<field name="scheme_year_id" readonly="1"/>
							<field name="query_date" invisible="1" />
						</group>
						<group>
							<field name="id" invisible="1"/>
							<field name="sdl_no" readonly="1" />
							<field name="wsp_submission_date" invisible="1" />
							<field name="wsp_end_period" invisible="1" />
							<field name="end_period" invisible="1" />
							<field name="request_query_date" invisible="1" />
							<field name="approve_query_date" invisible="1" />
							<field name="duplicate_total_mf_tep" invisible="1"/>
							<field name="show_query_date" invisible="1" />
						</group>
					</group>
					<group string="WSP Query">												
					</group>
					<group style="color: black;" >
							<field name="request_query_date" readonly="1" />
						</group>
					<group>
						<field name="query_reason_comment" required="1" />
					</group>
					
					<footer>
						<button string="Request Query" name="query_validate" type="object" class="oe_highlight" data-hotkey="q"/>
						<button string="Cancel" class="btn btn-secondary" special="cancel" data-hotkey="z"/>
					</footer>
				</form>
			</field>
		</record>
		
