<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <record id="atr_error_log_form_view" model="ir.ui.view">
            <field name="name">atr.error.log.form.view</field>
            <field name="model">atr.error.log</field>
            <field name="arch" type="xml">
                <form string="ATR Error Log">
                    <group>
                        <field name="show_atr_error_log"
                               nolabel="1"
                               readonly="1"
                               widget="html"/>
                    </group>

                    <footer>
                        <button name="action_download_incorrect_atr_file"
                                string="Download Incorrect Data File"
                                type="object"
                                class="btn-primary"/>

                        <button name="action_download_error_log"
                                string="Download ATR Error Log"
                                type="object"
                                class="btn-secondary"/>

                        <button name="action_delete_incorrect_records"
                                string="Clear Incorrect Records"
                                type="object"
                                class="btn-danger"
                                confirm="Are you sure you want to clear all incorrect records?"/>

                        <button string="Close"
                                special="cancel"
                                class="btn-secondary"/>
                    </footer>
                </form>
            </field>
        </record>

    </data>
</odoo>
