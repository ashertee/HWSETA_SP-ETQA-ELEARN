<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <!-- ===================================================== -->
        <!-- Export WSP / ATR Wizard Form -->
        <!-- ===================================================== -->
        <record id="export_wsp_xls_form_view" model="ir.ui.view">
            <field name="name">export.wsp.xls.form.view</field>
            <field name="model">export.wsp.xls</field>
            <field name="arch" type="xml">
                <form string="Export Report">
                    <group>
                        <label string="Select Annual Training Report or Workplace Skills Plan to export"/>
                    </group>

                    <footer>
                        <button name="export_previous_pdf"
                                string="ATR PDF"
                                type="object"
                                class="btn-primary"/>

                        <button name="export_previous_wsp"
                                string="WSP Excel"
                                type="object"
                                class="btn-secondary"/>

                        <button name="export_previous_wsp_pdf"
                                string="WSP PDF"
                                type="object"
                                class="btn-secondary"/>

                        <button string="Close"
                                special="cancel"
                                class="btn-secondary"/>
                    </footer>
                </form>
            </field>
        </record>

        <!-- ===================================================== -->
        <!-- Action: Open Export Wizard -->
        <!-- ===================================================== -->
        <record id="action_export_wsp_xls" model="ir.actions.act_window">
            <field name="name">Export WSP</field>
            <field name="res_model">export.wsp.xls</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
            <field name="binding_model_id" ref="model_wsp_plan"/>
            <field name="binding_view_types">form</field>
        </record>

    </data>
</odoo>
