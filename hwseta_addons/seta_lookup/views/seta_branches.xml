<?xml version="1.0" encoding="utf-8"?>
<odoo>


	<record id="seta_branches_list_view" model="ir.ui.view">
		<field name="name">seta.branches.list.view</field>
		<field name="model">seta.branches</field>
		<field name="arch" type="xml">
			<list  delete="false" duplicate="false">
			
				<field name="name"/>
                <field name="branch_address"/>
				<!-- <field name="setmis_lookup" string ="SETMIS Lookup"/>
				<field name="nlrd_lookup" string="NLRD Lookup"/> -->

			</list>
		</field>
	</record>

	<record id="seta_branches_form_view" model="ir.ui.view">
		<field name="name">seta.branches.form.view</field>
		<field name="model">seta.branches</field>
		<field name="arch" type="xml">
			<form  duplicate="false" delete="false">

                <sheet>
                    <group>
                       <group string="Lookup Details">
                            <field name="name"/>
                            <field name="branch_address"/>
                            <!-- <field name="setmis_lookup" string ="SETMIS Lookup"/>
							<field name="nlrd_lookup" string="NLRD Lookup"/> -->
                      </group>

                    </group>
                </sheet>
			</form>
		</field>
	</record>

	<record id="seta_branches_action" model="ir.actions.act_window">
		<field name="name">SETA Branches</field>
		<field name="res_model">seta.branches</field>
		<field name="type">ir.actions.act_window</field>
		<field name="context">{}</field>
		<field name="view_mode">list,form</field>
	</record>
	<menuitem id="master_sub_menu_seta_branches" parent="master_menu_seta_lookup" sequence= "1" name= "SETA Branch" action="seta_branches_action" />

</odoo>