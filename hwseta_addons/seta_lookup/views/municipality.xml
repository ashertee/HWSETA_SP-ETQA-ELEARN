	<record id="res_municipality_list_view" model="ir.ui.view">
		<field name="name">res.municipality.list.view</field>
		<field name="model">res.municipality</field>
		<field name="arch" type="xml">
			<list delete="false" duplicate="false" create="false">


				<field name="name"/>
				<field name="province_code" string="Province"/>
				<field name="setmis_lookup" string ="SETMIS Lookup"/>
				<field name="nlrd_lookup" string="NLRD Lookup"/>
			</list>
		</field>
	</record>

	<record id="res_municipality_form_view" model="ir.ui.view">
		<field name="name">res.municipality.form.view</field>
		<field name="model">res.municipality</field>
		<field name="arch" type="xml">
			<form delete="false" duplicate="false">
                <sheet>
                    <group>
						<group string="Lookup Details">
                            <field name="name"/>
						</group>
						<group string=" ">
							<field name="district_id" options="{'no_open':True}"/>
							<field name="province_code" options="{'no_open':True}"/>
							<field name="province_id"  options="{'no_open':True}"/>
							<field name="country_code"  options="{'no_open':True}"/>
							<field name="country_id" options="{'no_open':True}"/>
							<!-- <field name="country_id"/> -->
							<!--<field name="urban_rural"/>-->

						</group>
					</group>
						<notebook string="Related Information">
							<page string="Cities">
								<field name="city_ids">
									<list  duplicate="false">
										<field name="name"/>
									</list>
								</field>
							</page>
						</notebook>
                </sheet>
			</form>
		</field>
	</record>

	<record id="res_municipality_action" model="ir.actions.act_window">
		<field name="name">Municipality</field>
		<field name="res_model">res.municipality</field>
		<field name="type">ir.actions.act_window</field>
		<field name="context">{}</field>
		<field name="view_mode">list,form</field>
	</record>
	<menuitem id="master_sub_menu_res_municipality" parent="master_menu_seta_lookup" sequence= "1" name= "Municipality" action="res_municipality_action"/>

</odoo>