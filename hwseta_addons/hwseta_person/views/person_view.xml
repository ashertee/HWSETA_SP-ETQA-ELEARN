<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- =========================================================
         HR Department – Manager Domain
    ========================================================== -->
    <record id="view_department_form_inherit_hr_domain" model="ir.ui.view">
        <field name="name">hr.department.form.inherit.hr.domain</field>
        <field name="model">hr.department</field>
        <field name="inherit_id" ref="hr.view_department_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='manager_id']" position="attributes">
                <attribute name="domain">
                    [('is_learner','=',False),
                     ('is_sdf','=',False),
                     ('is_assessors','=',False),
                     ('is_moderators','=',False)]
                </attribute>
            </xpath>
        </field>
    </record>

    <!-- =========================================================
         Users – Province Mapping
    ========================================================== -->
    <record id="view_users_form_inherit_for_province" model="ir.ui.view">
        <field name="name">res.users.form.inherit.for.province</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='tz']" position="after">
                <field name="province_ids" widget="many2many_tags"/>
            </xpath>
        </field>
    </record>

    <!-- =========================================================
         Branch / Department Enhancements
    ========================================================== -->
    <record id="view_department_form_inherit_for_branch" model="ir.ui.view">
        <field name="name">hr.department.form.inherit.for.branch</field>
        <field name="model">hr.department</field>
        <field name="inherit_id" ref="hr.view_department_form"/>
        <field name="arch" type="xml">

            <xpath expr="//group/field[@name='name']" position="before">
                <group>
                    <field name="is_branch"/>
                    <field name="code" invisible="not is_branch"/>
                </group>
            </xpath>

            <xpath expr="//field[@name='parent_id']" position="attributes">
                <attribute name="invisible">is_branch</attribute>
                <attribute name="domain">
                    [('is_branch','=',False),('id','!=',id)]
                </attribute>
            </xpath>

            <xpath expr="//field[@name='parent_id']" position="before">
                <field name="dept_branch_id"
                       domain="[('is_branch','=',True)]"
                       invisible="is_branch"/>
            </xpath>

            <xpath expr="//field[@name='manager_id']" position="after">
                <field name="parent_branch_id"
                       domain="[('is_branch','=',True),('id','!=',id)]"
                       invisible="not is_branch"/>

                <label for="branch_address1"
                       string="Address"
                       invisible="not is_branch"/>

                <div invisible="not is_branch">
                    <field name="branch_address1"/>
                    <field name="branch_address2"/>
                    <field name="branch_address3"/>

                    <div class="address_format">
                        <field name="branch_city"/>
                        <field name="branch_province_id"
                               options="{'no_open': True}"/>
                        <field name="branch_zip"/>
                    </div>

                    <field name="branch_country_id"
                           options="{'no_open': True}"/>
                </div>
            </xpath>

        </field>
    </record>


    <!-- =========================================================
         Branch Action
    ========================================================== -->
    <record id="action_branch_view" model="ir.actions.act_window">
        <field name="name">Branches</field>
        <field name="res_model">hr.department</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('is_branch','=',True)]</field>
        <field name="context">{'default_is_branch': True}</field>
    </record>

    <!-- =========================================================
         SIC Code
    ========================================================== -->
    <record id="view_sic_code_tree_view" model="ir.ui.view">
        <field name="name">view.sic.code.list.view</field>
        <field name="model">hwseta.sic.master</field>
        <field name="arch" type="xml">
            <list>
                <field name="seta_id"/>
                <field name="code"/>
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="view_sic_code_form_view" model="ir.ui.view">
        <field name="name">view.sic.code.form.view</field>
        <field name="model">hwseta.sic.master</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="seta_id"/>
                        <field name="code"/>
                        <field name="name"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_sic_code" model="ir.actions.act_window">
        <field name="name">SIC Code</field>
        <field name="res_model">hwseta.sic.master</field>
        <field name="view_mode">list,form</field>
    </record>

<record id="view_seta_branch_form_view" model="ir.ui.view">
    <field name="name">seta.branches.form</field>
    <field name="model">seta.branches</field>
    <field name="arch" type="xml">
       <form string="SETA Branches">
          <sheet>
             <group>
                <field name="name" required="1" placeholder="e.g. Gauteng Branch"/>
                <field name="branch_address" placeholder="Full street address..."/>
             </group>
          </sheet>
       </form>
    </field>
</record>

<record id="view_seta_branch_tree_view" model="ir.ui.view">
    <field name="name">seta.branches.list</field>
    <field name="model">seta.branches</field>
    <field name="arch" type="xml">
       <list string="SETA Branches">
          <field name="name" decoration-bf="1"/>
          <field name="branch_address"/>
       </list>
    </field>
</record>

<record id="action_seta_branch" model="ir.actions.act_window">
    <field name="name">SETA Branch</field>
    <field name="res_model">seta.branches</field>
    <field name="view_mode">list,form</field>
    <field name="view_id" ref="view_seta_branch_tree_view" />
    <field name="help" type="html">
       <p class="o_view_nocontent_smiling_face">
          Click to create SETA Branches.
       </p>
    </field>
</record>

<record id="hr.hr_department_tree_action" model="ir.actions.act_window">
    <field name="name">Departments</field>
    <field name="res_model">hr.department</field>
    <field name="view_mode">list,kanban,form</field>
    <field name="domain">[('is_branch','=',False)]</field>
    <field name="search_view_id" ref="hr.view_department_filter" />
    <field name="help" type="html">
       <p class="o_view_nocontent_smiling_face">
          Click to create a department.
       </p>
       <p>
          Odoo's department structure manages document flow for employees
          (expenses, timesheets, leaves).
       </p>
    </field>
</record>

