<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="update_provider_info_form" model="ir.ui.view">
            <field name="name">update.provider.wizard.form</field>
            <field name="model">update.provider</field>
            <field name="arch" type="xml">
                <form string="Update Provider Information">
                    <header>
                        <field name="page" widget="statusbar" clickable="True"/>
                    </header>
                    <sheet>
                        <div invisible="page != 'terms'">
                            <group string="Provider Profile">
                                <field name='provider_id' options="{'no_create': True, 'no_open': True}"/>
                            </group>

                            <group string="Terms and Conditions">
                                <div class="alert alert-warning" role="alert">
                                    I, as the representative of the Skills Development Provider, take full responsibility of the amendments to the data in the company profile, and will not hold the Health and Welfare Sector Education and Training Authority (HWSETA) liable for any damages that may arise from the information uploaded below.
                                </div>
                                <field name='disclaimer' string="I accept the General Terms &amp; Conditions" required="page == 'terms'"/>
                            </group>

                            <group string="POPIA Compliance">
                                <div class="alert alert-info" role="alert">
                                    I authorize the HWSETA to share my personal information (Organisation name, accreditation number, contact details, and email) with stakeholders. Personal information relates specifically to me as a data subject as per the POPI Act.
                                </div>
                                <field name='update_disclaimer' string="I accept the POPIA Terms &amp; Conditions" required="page == 'terms'"/>
                            </group>
                        </div>

                        <div invisible="not disclaimer">
                            
                            <group string="General Details" invisible="page != 'contact'">
                                <field name='name_change'/>
                                <field name='name' 
                                    invisible="not name_change" 
                                    required="name_change"/>
                                <field name='phone' placeholder="0116076900"/>
                                <field name='mobile' placeholder="0824513619"/>
                                <field name='fax' placeholder="0116168939"/>
                                <field name='website' widget="url"/>
                            </group>

                            <group string="Work Address" invisible="page != 'address'">
                                <label for="street" string="Address"/>
                                <div class="o_address_format">
                                    <field name="street" placeholder="Street..." class="o_address_street"/>
                                    <field name="street2" placeholder="Street 2..." class="o_address_street"/>
                                    <field name="street3" placeholder="Street 3..." class="o_address_street"/>
                                    <field name="city" placeholder="City" class="o_address_city" options="{'no_open': True, 'no_create': True}"/>
                                    <field name="state_id" class="o_address_state" placeholder="Province" options="{'no_open': True, 'no_create': True}"/>
                                    <field name="zip" placeholder="ZIP" class="o_address_zip"/>
                                    <field name="country_id" placeholder="Country" class="o_address_country" options="{'no_open': True, 'no_create': True}"/>
                                </div>
                                <field name='suburb' options="{'no_create': True, 'no_open': True}"/>
                            </group>

                            <group string="Home/Physical Address" invisible="page != 'personal_addr'">
                                <field name='physical_address_1'/>
                                <field name='physical_address_2'/>
                                <field name='physical_address_3'/>
                                <field name='provider_physical_suburb' options="{'no_create': True, 'no_open': True}"/>
                                <field name='city_physical' options="{'no_create': True, 'no_open': True}"/>
                                <field name='province_code_physical' options="{'no_create': True, 'no_open': True}"/>
                                <field name='zip_physical'/>
                                <field name='country_code_physical' options="{'no_create': True, 'no_open': True}"/>
                            </group>

                            <group string="Postal Address" invisible="page != 'postal_addr'">
                                <field name='postal_address_1'/>
                                <field name='postal_address_2'/>
                                <field name='postal_address_3'/>
                                <field name='provider_postal_suburb' options="{'no_create': True, 'no_open': True}"/>
                                <field name='city_postal' options="{'no_create': True, 'no_open': True}"/>
                                <field name='province_code_postal' options="{'no_create': True, 'no_open': True}"/>
                                <field name='zip_postal'/>
                                <field name='country_code_postal' options="{'no_create': True, 'no_open': True}"/>
                            </group>

                            <group string="Business Info" invisible="page != 'business_info'">
                                <field name='txtCompanyRegNo'/>
                                <field name='txtVATRegNo'/>
                                <field name='cboProviderFocus' options="{'no_create': True, 'no_open': True}"/>
                                <field name='txtNumYearsCurrentBusiness'/>
                                <field name='txtNumStaffMembers'/>
                            </group>

                            <div invisible="page != 'business_docs'">
                                <div class="alert alert-danger" role="alert">
                                    <strong>Historical Note:</strong> Documents do not load from your profile. Adding a file here will <b>replace</b> the historical document on record.
                                </div>
                                <group string="Document Uploads">
                                    <field name='cipro_documents' widget="many2one_binary"/>
                                    <field name='tax_clearance' widget="many2one_binary"/>
                                    <field name='director_cv' widget="many2one_binary"/>
                                    <field name='certified_copies_of_qualifications' widget="many2one_binary"/>
                                    <field name='professional_body_registration' widget="many2one_binary"/>
                                    <field name='workplace_agreement' widget="many2one_binary"/>
                                    <field name='business_residence_proof' widget="many2one_binary"/>
                                    <field name='provider_learning_material' widget="many2one_binary"/>
                                    <field name='skills_programme_registration_letter' widget="many2one_binary"/>
                                    <field name='company_profile_and_organogram' widget="many2one_binary"/>
                                    <field name='quality_management_system' widget="many2one_binary"/>
                                    <field name='lease_agreement_document' widget="many2one_binary"/>
                                </group>
                            </div>

                            <div invisible="page != 'disclaimer'">
                                <div class="alert alert-info">
                                    By clicking update, you confirm all entered information is valid. Rejection will require a new submission.
                                </div>
                                <group>
                                    <button name="update" string="Submit Update Request" type="object" class="btn-primary" data-hotkey="q"/>
                                </group>
                            </div>
                        </div>
                    </sheet>
                    <footer>
                        <button string="Cancel" class="btn-secondary" special="cancel" data-hotkey="x"/>
                    </footer>
                </form>
            </field>
        </record>
        <record id="update_provider_info_admin_form" model="ir.ui.view">
            <field name="name">update.provider.wizard.admin.form</field>
            <field name="model">update.provider</field>
            <field name="arch" type="xml">
                <form string="Admin: Update Provider Information">
                    <header>
                        <field name="page" widget="statusbar" clickable="True"/>
                    </header>
                    <sheet>
                        <div invisible="page != 'terms'">
                            <group string="Provider Profile">
                                <field name='provider_id' options="{'no_create': True, 'no_open': True}"/>
                            </group>

                            <group string="Terms and Conditions">
                                <div class="alert alert-warning" role="alert">
                                    I, as the representative of the Skills Development Provider, take full responsibility for amendments to the company profile data and indemnify HWSETA against any damages arising from the information uploaded.
                                </div>
                                <field name='disclaimer' string="Accept Terms &amp; Conditions"/>
                            </group>

                            <group string="POPIA Compliance">
                                <div class="alert alert-info" role="alert">
                                    I authorize HWSETA to share my personal/organisational information (Name, Accreditation, Contact Details) with stakeholders as per the POPI Act.
                                </div>
                                <field name='update_disclaimer' string="Accept POPIA Terms"/>
                            </group>
                        </div>

                        <div invisible="not disclaimer">
                            
                            <group string="General Details" invisible="page != 'contact'">
                                <field name='name_change'/>
                                <field name='name' 
                                    invisible="not name_change" 
                                    required="name_change"/>
                                <field name='phone' placeholder="0116076900"/>
                                <field name='mobile' placeholder="0824513619"/>
                                <field name='fax' placeholder="0116168939"/>
                                <field name='website' widget="url"/>
                            </group>

                            <group string="Work Address" invisible="page != 'address'">
                                <label for="street" string="Address"/>
                                <div class="o_address_format">
                                    <field name="street" placeholder="Street..." class="o_address_street"/>
                                    <field name="street2" placeholder="Street 2..." class="o_address_street"/>
                                    <field name="street3" placeholder="Street 3..." class="o_address_street"/>
                                    <field name="city" placeholder="City" class="o_address_city" options="{'no_open': True, 'no_create': True}"/>
                                    <field name="state_id" class="o_address_state" placeholder="Province" options="{'no_open': True, 'no_create': True}"/>
                                    <field name="zip" placeholder="ZIP" class="o_address_zip"/>
                                    <field name="country_id" placeholder="Country" class="o_address_country" options="{'no_open': True, 'no_create': True}"/>
                                </div>
                                <field name='suburb' options="{'no_create': True, 'no_open': True}"/>
                            </group>

                            <group string="Home/Physical Address" invisible="page != 'personal_addr'">
                                <field name='physical_address_1'/>
                                <field name='physical_address_2'/>
                                <field name='physical_address_3'/>
                                <field name='provider_physical_suburb' options="{'no_create': True, 'no_open': True}"/>
                                <field name='city_physical' options="{'no_create': True, 'no_open': True}"/>
                                <field name='province_code_physical' options="{'no_create': True, 'no_open': True}"/>
                                <field name='zip_physical'/>
                                <field name='country_code_physical' options="{'no_create': True, 'no_open': True}"/>
                            </group>

                            <group string="Postal Address" invisible="page != 'postal_addr'">
                                <field name='postal_address_1'/>
                                <field name='postal_address_2'/>
                                <field name='postal_address_3'/>
                                <field name='provider_postal_suburb' options="{'no_create': True, 'no_open': True}"/>
                                <field name='city_postal' options="{'no_create': True, 'no_open': True}"/>
                                <field name='province_code_postal' options="{'no_create': True, 'no_open': True}"/>
                                <field name='zip_postal'/>
                                <field name='country_code_postal' options="{'no_create': True, 'no_open': True}"/>
                            </group>

                            <group string="Business Info" invisible="page != 'business_info'">
                                <field name='txtCompanyRegNo'/>
                                <field name='txtVATRegNo'/>
                                <field name='cboProviderFocus' options="{'no_create': True, 'no_open': True}"/>
                                <field name='txtNumYearsCurrentBusiness'/>
                                <field name='txtNumStaffMembers'/>
                            </group>

                            <div invisible="page != 'business_docs'">
                                <div class="alert alert-danger" role="alert">
                                    <strong>Important:</strong> Historical documents are not pre-loaded. Uploading a file here will <b>overwrite</b> the existing document on the provider profile.
                                </div>
                                <group string="Upload Updated Documents">
                                    <field name='cipro_documents' widget="many2one_binary"/>
                                    <field name='tax_clearance' widget="many2one_binary"/>
                                    <field name='director_cv' widget="many2one_binary"/>
                                    <field name='certified_copies_of_qualifications' widget="many2one_binary"/>
                                    <field name='professional_body_registration' widget="many2one_binary"/>
                                    <field name='workplace_agreement' widget="many2one_binary"/>
                                    <field name='business_residence_proof' widget="many2one_binary"/>
                                    <field name='provider_learning_material' widget="many2one_binary"/>
                                    <field name='skills_programme_registration_letter' widget="many2one_binary"/>
                                    <field name='company_profile_and_organogram' widget="many2one_binary"/>
                                    <field name='quality_management_system' widget="many2one_binary"/>
                                    <field name='lease_agreement_document' widget="many2one_binary"/>
                                </group>
                            </div>

                            <div invisible="page != 'admin'">
                                <div class="alert alert-secondary">
                                    <strong>Admin Only:</strong> This page contains NLRD classification data. Non-admins may skip this step.
                                </div>
                                <group string="Internal Classification">
                                    <field name='provider_type_id'/>
                                    <field name='provider_class_Id'/>
                                    <field name='provider_start_date'/>
                                    <field name='provider_end_date'/>
                                </group>
                            </div>

                            <div invisible="page != 'disclaimer'">
                                <div class="alert alert-info">
                                    By clicking update, you confirm all information is accurate. Errors will result in rejection and require a new transaction.
                                </div>
                                <group>
                                    <button name="update" string="Submit Update" type="object" class="btn-primary" data-hotkey="q"/>
                                </group>
                            </div>
                        </div>
                    </sheet>
                    <footer>
                        <button string="Cancel" class="btn-secondary" special="cancel" data-hotkey="x"/>
                    </footer>
                </form>
            </field>
        </record>
		<record id="action_update_provider" model="ir.actions.act_window">
            <field name="name">Update Provider Info</field>
            <field name="res_model">update.provider</field>
            <field name="view_mode">form</field>
            <field name="view_id" ref="update_provider_info_form"/>
            <field name="target">new</field>
        </record>

        <record id="action_update_provider_admin" model="ir.actions.act_window">
            <field name="name">Admin: Update Provider Info</field>
            <field name="res_model">update.provider</field>
            <field name="view_mode">form</field>
            <field name="view_id" ref="update_provider_info_admin_form"/>
            <field name="target">new</field>
        </record>

