        <record id="view_updated_providers_tree" model="ir.ui.view">
            <field name="name">updated.providers.list</field>
            <field name="model">updated.providers</field>
            <field name="arch" type="xml">
                <list string="Update Requests" create="false" sample="1">
                    <field name="reference" decoration-bf="1"/>
                    <field name="provider_id"/>
                    <field name="create_date" string="Submitted On"/>
                    <field name="action_date" string="Processed On"/>
                    <field name="action_partner" widget="many2one_avatar_user"/>
                    <field name="status" widget="badge" 
                           decoration-info="status == 'submitted'" 
                           decoration-success="status == 'approved'" 
                           decoration-danger="status == 'rejected'"/>
                </list>
            </field>
        </record>

        <record id="updated_provider_search" model="ir.ui.view">
            <field name="name">updated.providers.search</field>
            <field name="model">updated.providers</field>
            <field name="arch" type="xml">
                <search string="Update Search">
                    <field name="reference"/>
                    <field name="provider_id"/>
                    <filter string="Submitted" name="status_submitted" domain="[('status', '=', 'submitted')]"/>
                    <filter string="Approved" name="status_approved" domain="[('status', '=', 'approved')]"/>
                    <group expand="0" string="Group By">
                        <filter string="Provider" name="group_by_provider" context="{'group_by': 'provider_id'}"/>
                        <filter string="Status" name="group_by_status" context="{'group_by': 'status'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="view_updated_provider_reject_wiz_form" model="ir.ui.view">
            <field name="name">updated.providers.reject.wiz.form</field>
            <field name="model">updated.providers.reject.wiz</field>
            <field name="arch" type="xml">
                <form string="Reject Update">
                    <sheet>
                        <group>
                            <field name="comment" required="1" placeholder="Enter reason for rejection..."/>
                        </group>
                    </sheet>
                    <footer>
                        <button name="reject_update" string="Confirm Reject" type="object" class="btn-danger" data-hotkey="q"/>
                        <button string="Cancel" class="btn-secondary" special="cancel" data-hotkey="x"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="action_view_updated_provider_reject_wiz_form" model="ir.actions.act_window">
            <field name="name">Reject Provider Update</field>
            <field name="res_model">updated.providers.reject.wiz</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>
        <record id="view_updated_providers_form" model="ir.ui.view">
            <field name="name">updated.providers.form</field>
            <field name="model">updated.providers</field>
            <field name="arch" type="xml">
                <form string="Provider Update Request" create="false" edit="false">
                    <header>
                        <button name="approve_update" string="Approve" 
                                type="object" class="btn-primary" 
                                invisible="status != 'submitted'"
                                groups="hwseta_etqe.group_updated_provider_wiz,hwseta_etqe.group_seta_administrator"
                                data-hotkey="v"/>
                        
                        <button name="%(action_view_updated_provider_reject_wiz_form)d" 
                                type="action" string="Reject" 
                                class="btn-outline-danger" 
                                invisible="status != 'submitted'"
                                context="{'update_id': id}"
                                groups="hwseta_etqe.group_updated_provider_wiz,hwseta_etqe.group_seta_administrator"
                                data-hotkey="z"/>
                        
                        <field name="status" widget="statusbar" statusbar_visible="submitted,approved,rejected"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <h1><field name="reference" readonly="1"/></h1>
                        </div>
                        <group>
                            <group>
                                <field name='provider_id' options="{'no_open': True}"/>
                                <field name='disclaimer' readonly="1"/>
                                <field name='update_disclaimer' string="POPIA Consent" readonly="1"/>
                            </group>
                        </group>

                        <notebook>
                            <page string="General &amp; Address Details" name="general_details">
                                <div class="row">
                                    <div class="col-6 border-end bg-light p-3">
                                        <h3 class="text-center text-muted">Previous Information</h3>
                                        <group string="General">
                                            <field name='related_name' string="Name"/>
                                            <field name='related_phone' string="Phone"/>
                                            <field name='related_mobile' string="Mobile"/>
                                            <field name='related_fax' string="Fax"/>
                                            <field name='related_website' string="Website"/>
                                        </group>
                                        <group string="Work Address">
                                            <field name='related_street' string="Street"/>
                                            <field name='related_suburb' string="Suburb"/>
                                            <field name='related_city' string="City"/>
                                            <field name='related_zip' string="Postal Code"/>
                                        </group>
                                        <group string="Physical Address">
                                            <field name='related_physical_address_1' string="Street"/>
                                            <field name='related_city_physical' string="City"/>
                                        </group>
                                    </div>
                                    
                                    <div class="col-6 p-3">
                                        <h3 class="text-center text-primary">Requested Updates</h3>
                                        <group string="General">
                                            <field name='name'/>
                                            <field name='phone'/>
                                            <field name='mobile'/>
                                            <field name='fax'/>
                                            <field name='website'/>
                                        </group>
                                        <group string="Work Address">
                                            <field name='street'/>
                                            <field name='suburb'/>
                                            <field name='city'/>
                                            <field name='zip'/>
                                        </group>
                                        <group string="Physical Address">
                                            <field name='physical_address_1'/>
                                            <field name='city_physical'/>
                                        </group>
                                    </div>
                                </div>
                            </page>

                            <page string="Documents &amp; Compliance" name="business_docs">
                                <div class="row">
                                    <div class="col-6 border-end bg-light p-3">
                                        <h3 class="text-center text-muted">Original Files</h3>
                                        <group>
                                            <field name='related_cipro_documents' widget="many2one_binary"/>
                                            <field name='related_tax_clearance' widget="many2one_binary"/>
                                            <field name='related_director_cv' widget="many2one_binary"/>
                                            <field name='related_quality_management_system' widget="many2one_binary"/>
                                        </group>
                                    </div>
                                    <div class="col-6 p-3">
                                        <h3 class="text-center text-primary">New Uploads</h3>
                                        <group>
                                            <field name='cipro_documents' widget="many2one_binary"/>
                                            <field name='tax_clearance' widget="many2one_binary"/>
                                            <field name='director_cv' widget="many2one_binary"/>
                                            <field name='quality_management_system' widget="many2one_binary"/>
                                        </group>
                                    </div>
                                </div>
                            </page>

                            <page string="Internal Admin" name="admin_details">
                                <div class="row">
                                    <div class="col-6 border-end bg-light p-3">
                                        <group string="Previous Classifications">
                                            <field name='related_provider_type_id'/>
                                            <field name='related_provider_class_Id'/>
                                            <field name='related_provider_start_date'/>
                                        </group>
                                    </div>
                                    <div class="col-6 p-3">
                                        <group string="Updated Classifications">
                                            <field name='provider_type_id'/>
                                            <field name='provider_class_Id'/>
                                            <field name='provider_start_date'/>
                                        </group>
                                    </div>
                                </div>
                            </page>
                        </notebook>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>
        <record id="action_updated_providers_tree" model="ir.actions.act_window">
            <field name="name">Provider Update Requests</field>
            <field name="res_model">updated.providers</field>
            <field name="view_mode">list,form</field>
            <field name="search_view_id" ref="hwseta_etqe.updated_provider_search" />
            <field name="view_id" ref="view_updated_providers_tree"/>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    No pending provider updates!
                </p>
                <p>
                    All Skills Development Provider update requests have been processed. 
                    New requests will appear here for validation and approval.
                </p>
            </field>
        </record>

        <menuitem id="menu_updated_providers"
                  name="Updated Provider Info"
                  action="action_updated_providers_tree"
                  parent="transaction_menu"
                  groups="hwseta_etqe.group_seta_administrator,hwseta_etqe.group_updated_provider_wiz"
                  sequence="7"/>

    </data>
</odoo>
