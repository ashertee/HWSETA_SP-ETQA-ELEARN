<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_updated_campuses_reject_wiz_form" model="ir.ui.view">
            <field name="name">updated.campuses.reject.wiz.form</field>
            <field name="model">updated.campuses.reject.wiz</field>
            <field name="arch" type="xml">
                <form string="Reject Update">
                    <sheet>
                        <group>
                            <field name="comment" required="1" placeholder="Provide a reason for rejection..."/>
                        </group>
                    </sheet>
                    <footer>
                        <button name="reject_update" string="Reject Update" type="object" class="btn-danger" data-hotkey="q"/>
                        <button string="Cancel" class="btn-secondary" special="cancel" data-hotkey="x"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="action_view_updated_campuses_reject_wiz_form" model="ir.actions.act_window">
            <field name="name">Reject Campus Update</field>
            <field name="res_model">updated.campuses.reject.wiz</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>

        <record id="view_updated_campuses_approve_wiz_form" model="ir.ui.view">
            <field name="name">updated.campuses.approve.wiz.form</field>
            <field name="model">updated.campuses.approve.wiz</field>
            <field name="arch" type="xml">
                <form string="Approve Update">
                    <sheet>
                        <group>
                            <field name="comment" required="1" placeholder="Add approval notes..."/>
                        </group>
                    </sheet>
                    <footer>
                        <button name="approve_update" string="Approve Update" type="object" class="btn-primary" data-hotkey="v"/>
                        <button string="Cancel" class="btn-secondary" special="cancel" data-hotkey="x"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="action_view_updated_campuses_approve_wiz_form" model="ir.actions.act_window">
            <field name="name">Approve Campus Update</field>
            <field name="res_model">updated.campuses.approve.wiz</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>

        <record id="update_campus_info_form" model="ir.ui.view">
            <field name="name">update.campus.wizard.form</field>
            <field name="model">update.campus</field>
            <field name="arch" type="xml">
                <form string="Update Campus Information">
                    <sheet>
                        <group string="Provider Profile">
                            <field name='provider_id' options="{'no_create': True, 'no_open': True}"/>
                            <field name="accreditation_id" invisible="1"/>
                        </group>

                        <group string="Campus Details" invisible="action == 'create'">
                            <field name="campus_id" 
                                domain="[('provider_accreditation_campus_id','=',accreditation_id)]" 
                                options="{'no_create': True, 'no_open': True}"/>
                        </group>

                        <group string="Terms and Conditions">
                            <div class="alert alert-info" role="alert">
                                <ul class="list-unstyled mb-0">
                                    <li><i class="fa fa-external-link me-2"/><a href="https://portal.hwseta.org.za/hwseta/material_disclaimer" target="_blank">View HWSETA Terms and Conditions</a></li>
                                    <li><i class="fa fa-external-link me-2"/><a href="https://portal.hwseta.org.za/hwseta/popi_disclaimer" target="_blank">View HWSETA POPIA Terms and Conditions</a></li>
                                </ul>
                            </div>
                            <field name="disclaimer" required="1"/>
                            <field name="update_disclaimer" required="1"/>
                        </group>

                        <group string="Contact Info" readonly="action == 'delete'">
                            <field name="name" string="Satellite Name"/>
                            <field name="phone" required="1"/>
                            <field name="mobile" required="1"/>
                            <field name="email" options="{'no_create': True}"/>
                        </group>

                        <group string="Address Details" invisible="action == 'delete'">
                            <field name="street"/>
                            <field name="street2"/>
                            <field name="street3"/>
                            <field name="zip"/>
                            <field name="suburb" options="{'no_create': True, 'no_open': True}"/>
                            <field name="city" options="{'no_create': True, 'no_open': True}"/>
                            <field name="state_id" options="{'no_create': True, 'no_open': True}"/>
                            <field name="country_id" options="{'no_create': True, 'no_open': True}"/>
                        </group>
                    </sheet>
                    <footer>
                        <button type="object" name="update" string="Update Campus" 
                                class="btn-primary" invisible="action != 'update'" 
                                groups="hwseta_etqe.group_seta_administrator,hwseta_etqe.group_providers" />
                        
                        <button type="object" name="update" string="Create Campus" 
                                class="btn-primary" invisible="action != 'create'" 
                                groups="hwseta_etqe.group_seta_administrator,hwseta_etqe.group_providers" />
                        
                        <button type="object" name="update" string="Delete Campus" 
                                class="btn-danger" invisible="action != 'delete'" 
                                groups="hwseta_etqe.group_seta_administrator,hwseta_etqe.group_providers" />
                        
                        <button string="Cancel" class="btn-secondary" special="cancel" data-hotkey="x"/>
                    </footer>
                </form>
            </field>
        </record>


		<record id="action_update_campus" model="ir.actions.act_window">
            <field name="name">Update Satellite Campus</field>
            <field name="res_model">update.campus</field>
            <field name="view_mode">form</field>
            <field name="context">{'default_action': 'update'}</field>
            <field name="view_id" ref="update_campus_info_form"/>
            <field name="target">new</field>
        </record>

        <record id="action_create_campus" model="ir.actions.act_window">
            <field name="name">Create New Campus</field>
            <field name="res_model">update.campus</field>
            <field name="view_mode">form</field>
            <field name="view_id" ref="update_campus_info_form"/>
            <field name="context">{'default_action': 'create'}</field>
            <field name="target">new</field>
        </record>

        <record id="action_delete_campus" model="ir.actions.act_window">
            <field name="name">Delete Satellite Campus</field>
            <field name="res_model">update.campus</field>
            <field name="view_mode">form</field>
            <field name="context">{'default_action': 'delete'}</field>
            <field name="view_id" ref="update_campus_info_form"/>
            <field name="target">new</field>
        </record>

        <record id="view_updated_campuses_tree" model="ir.ui.view">
            <field name="name">updated.campuses.list</field>
            <field name="model">updated.campuses</field>
            <field name="arch" type="xml">
                <list string="Campus Requests" create="false" sample="1">
                    <field name="provider_id" string="Provider"/>
                    <field name="sequence_number"/>
                    <field name="name" string="Campus Name"/>
                    <field name='phone'/>
                    <field name='email' widget="email"/>
                    <field name='city'/>
                    <field name='action' widget="badge" 
                           decoration-info="action == 'update'" 
                           decoration-success="action == 'create'" 
                           decoration-danger="action == 'delete'"/>
                    <field name='transaction_status' widget="badge" 
                           decoration-warning="transaction_status == 'submitted'" 
                           decoration-success="transaction_status == 'approved'" 
                           decoration-danger="transaction_status == 'rejected'"/>
                    <field name='create_date' string="Submitted On"/>
                </list>
            </field>
        </record>

        <record id="view_updated_campuses_form" model="ir.ui.view">
            <field name="name">updated.campuses.form</field>
            <field name="model">updated.campuses</field>
            <field name="arch" type="xml">
                <form string="Campus Update Request" create="false">
                    <header>
                        <button name="approve_update" string="Approve" 
                                type="object" class="btn-primary" 
                                invisible="transaction_status != 'submitted'"
                                groups="hwseta_etqe.group_satellite_campus_admin"
                                data-hotkey="v"/>
                        
                        <button name="reject_update" string="Reject" 
                                type="object" class="btn-outline-danger" 
                                invisible="transaction_status != 'submitted'"
                                groups="hwseta_etqe.group_satellite_campus_admin"
                                data-hotkey="z"/>
                        
                        <field name="transaction_status" widget="statusbar" statusbar_visible="submitted,approved,rejected"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <h1><field name="sequence_number" readonly="1"/></h1>
                        </div>
                        <group>
                            <group>
                                <field name='provider_id' readonly="1"/>
                                <field name='create_date' readonly="1"/>
                            </group>
                            <group>
                                <field name="disclaimer" readonly="1"/>
                                <field name="update_disclaimer" readonly="1"/>
                                <field name="action" invisible="1"/>
                            </group>
                        </group>

                        <group string="Decision Feedback">
                            <field name="comment" placeholder="Enter reason for decision..." required="transaction_status == 'submitted'"/>
                        </group>

                        <div class="row">
                            <div class="col-6 border-end bg-light p-3" invisible="action == 'create'">
                                <h3 class="text-center">Previous Details</h3>
                                <group>
                                    <field name='related_name' string="Name"/>
                                    <field name='related_phone' string="Phone"/>
                                    <field name='related_mobile' string="Mobile"/>
                                    <field name='related_street' string="Street"/>
                                    <field name='related_city' string="City"/>
                                    <field name='related_email' string="Email"/>
                                </group>
                            </div>
                            <div class="col-6 p-3">
                                <h3 class="text-center">Updated Details</h3>
                                <group>
                                    <field name='name'/>
                                    <field name='phone'/>
                                    <field name='mobile'/>
                                    <field name='street'/>
                                    <field name='city'/>
                                    <field name='email'/>
                                </group>
                            </div>
                        </div>
                    </sheet>
                </form>
            </field>
        </record>
        <record id="action_updated_campuses_tree" model="ir.actions.act_window">
            <field name="name">SETA Updated Campuses</field>
            <field name="res_model">updated.campuses</field>
            <field name="view_mode">list,form</field>
            <field name="view_id" ref="view_updated_campuses_tree"/>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    No pending campus updates found.
                </p>
            </field>
        </record>

        <record id="view_master_campuses_tree" model="ir.ui.view">
            <field name="name">master.campuses.list</field>
            <field name="model">master.campuses</field>
            <field name="arch" type="xml">
                <list string="Master Campuses" sample="1">
                    <field name="name" decoration-bf="1"/>
                    <field name="street"/>
                    <field name="city"/>
                    <field name="state_id" optional="show"/>
                    <field name="country_id" optional="hide"/>
                    <field name="phone" widget="phone"/>
                    <field name="email" widget="email"/>
                </list>
            </field>
        </record>

        <record id="view_master_campuses_form" model="ir.ui.view">
            <field name="name">master.campuses.form</field>
            <field name="model">master.campuses</field>
            <field name="arch" type="xml">
                <form string="Master Campus Profile">
                    <sheet>
                        <div class="oe_title">
                            <label for="name" string="Campus Name"/>
                            <h1><field name="name" placeholder="e.g. Pretoria Main Campus"/></h1>
                        </div>
                        <group>
                            <group string="Compliance &amp; Terms">
                                <field name="disclaimer" widget="boolean_toggle"/>
                                <field name="update_disclaimer" widget="boolean_toggle"/>
                                <field name="designation"/>
                            </group>
                            <group string="Communication">
                                <field name="phone" widget="phone"/>
                                <field name="mobile" widget="phone"/>
                                <field name="fax"/>
                                <field name="email" widget="email"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Address Details" name="address">
                                <group>
                                    <group>
                                        <label for="street" string="Address"/>
                                        <div class="o_address_format">
                                            <field name="street" placeholder="Street..." class="o_address_street"/>
                                            <field name="street2" placeholder="Street 2..." class="o_address_street"/>
                                            <field name="street3" placeholder="Street 3..." class="o_address_street"/>
                                            <field name="city" placeholder="City" class="o_address_city"/>
                                            <field name="state_id" class="o_address_state" placeholder="State" options="{'no_open': True, 'no_quick_create': True}"/>
                                            <field name="zip" placeholder="ZIP" class="o_address_zip"/>
                                            <field name="country_id" placeholder="Country" class="o_address_country" options="{'no_open': True, 'no_create': True}"/>
                                        </div>
                                    </group>
                                    <group>
                                        <field name="suburb" options="{'no_create': True}"/>
                                    </group>
                                </group>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="view_master_campuses_search" model="ir.ui.view">
            <field name="name">master.campuses.search</field>
            <field name="model">master.campuses</field>
            <field name="arch" type="xml">
                <search string="Search Master Campuses">
                    <field name="name" string="Campus Name" filter_domain="['|', ('name', 'ilike', self), ('email', 'ilike', self)]"/>
                    <field name="city"/>
                    <field name="state_id"/>
                    <field name="country_id"/>
                    <separator/>
                    <group expand="0" string="Group By">
                        <filter string="Province" name="group_by_province" context="{'group_by': 'state_id'}"/>
                        <filter string="City" name="group_by_city" context="{'group_by': 'city'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="action_master_campuses" model="ir.actions.act_window">
            <field name="name">Master Campuses</field>
            <field name="res_model">master.campuses</field>
            <field name="view_mode">list,form</field>
            <field name="search_view_id" ref="view_master_campuses_search"/>
        </record>

