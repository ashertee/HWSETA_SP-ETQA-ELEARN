                  name="Updated Campuses"
                  action="action_updated_campuses_tree"
                  parent="transaction_menu"
                  groups="hwseta_etqe.group_seta_administrator,hwseta_etqe.group_satellite_campus_admin"
                  sequence="7"/>
    </data>
</odoo>
