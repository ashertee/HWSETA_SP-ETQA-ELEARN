        <!-- Provider Update Submitted Notification -->
        <record id="email_template_prov_update_submit_notification" model="mail.template">
            <field name="name">Update Provider Information - Stakeholder – Submitted</field>
            <field name="subject">
                Ref #: ${object.reference} - Update Provider Information – Submitted
            </field>
            <field name="email_from">no-reply@hwseta.org.za</field>
            <field name="email_to">${object.provider_id.email}</field>
            <field name="model_id" ref="hwseta_etqe.model_updated_providers"/>
            <field name="auto_delete" eval="False"/>
            <field name="lang">en_US</field>
            <field name="body_html">
                <![CDATA[
                <div style="font-family: Lucida Grande, Helvetica, Verdana, Arial, sans-serif;
                            font-size: 13px; color: #4c4c4c;">
                    <p>Good Day, ${object.provider_id.name}</p>

                    <p>
                        Your request to update information for
                        ${object.provider_id.provider_accreditation_num}
                        - ${object.provider_id.name}
                        has been submitted. An HWSETA official will process your request shortly.
                    </p>

                    <p>
                        Please note, if any information in the transaction is found to be invalid,
                        the transaction will be rejected.
                    </p>

                    <p>
                        If you would like to follow up on this transaction, please log a ticket in the
                        <a href="https://helpdesk.hwseta.org.za/portal">HWSETA helpdesk</a>
                        with the Ref #: ${object.reference}.
                    </p>

                    <p>Regards</p>
                </div>
                ]]>
            </field>
        </record>

