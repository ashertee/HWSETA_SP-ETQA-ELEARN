<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <template id="provider_verification_layout">
            <t t-if="not o" t-set="o" t-value="doc"/>

            <t t-if="o and 'company_id' in o">
                <t t-set="company" t-value="o.company_id"/>
            </t>
            <t t-else="">
                <t t-set="company" t-value="res_company"/>
            </t>

            <t t-call="hwseta_etqe.verification_report_layout_header"/>

            <div class="article" t-att-data-oe-model="o and o._name" t-att-data-oe-id="o and o.id" t-att-data-oe-lang="o and o.env.context.get('lang')">
                <t t-out="0"/>
            </div>

            <div class="footer o_standard_footer">
                <div class="text-center" style="border-top: 1px solid black;">
                    <ul class="list-inline mb4">
                        <li t-if="company.phone" class="list-inline-item">Phone: <span t-field="company.phone"/></li>
                        <li t-if="company.email" class="list-inline-item">Email: <span t-field="company.email"/></li>
                    </ul>
                </div>
            </div>
        </template>

        <template id="verification_report_layout_header">
            <div class="header">
                <div class="row">
                    <div class="col-6">
                        <img t-if="company.logo" t-att-src="image_data_uri(company.logo)" style="max-height: 45px;" alt="Logo"/>
                    </div>
                    <div class="col-6 text-end">
                        <div class="fw-bold">VERIFICATION REPORT 2014/15</div>
                        <ul class="list-inline">
                            <li class="list-inline-item">Page:</li>
                            <li class="list-inline-item">
                                <span class="page"/> / <span class="topage"/>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
        </template>

    </data>
</odoo>