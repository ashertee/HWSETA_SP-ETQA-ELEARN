<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="paperformat_etqe_acc" model="report.paperformat">
            <field name="name">Provider Accreditation</field>
            <field name="default" eval="True" />
            <field name="format">A3</field>
            <field name="page_height">0</field>
            <field name="page_width">0</field>
            <field name="orientation">Portrait</field>
            <field name="margin_top">40</field>
            <field name="margin_bottom">20</field>
            <field name="margin_left">7</field>
            <field name="margin_right">7</field>
            <field name="header_line" eval="False" />
            <field name="header_spacing">30</field>
            <field name="dpi">90</field>
        </record>

        <record id="accreditation_certificate_id" model="ir.actions.report">
            <field name="name">Certificate Of Accreditation</field>
            <field name="model">provider.accreditation</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">hwseta_etqe.report_accreditation_certificate</field>
            <field name="report_file">hwseta_etqe.report_accreditation_certificate</field>
            <field name="print_report_name">'Certificate - %s' % (object.name)</field>
            <field name="binding_model_id" ref="model_provider_accreditation"/>
            <field name="binding_type">report</field>
            <field name="paperformat_id" ref="paperformat_etqe_acc"/>
            <field name="groups_id" eval="[(4, ref('hwseta_etqe.group_etqe_manager')), 
                                          (4, ref('hwseta_etqe.group_etqe_executive_manager')), 
                                          (4, ref('hwseta_etqe.group_etqe_provincial_manager')), 
                                          (4, ref('hwseta_etqe.group_etqe_officer')), 
                                          (4, ref('hwseta_etqe.group_etqe_provincial_officer')), 
                                          (4, ref('hwseta_etqe.group_etqe_provincial_administrator')), 
                                          (4, ref('hwseta_etqe.group_etqe_administrator'))]"/>
        </record>
    </data>
</odoo>