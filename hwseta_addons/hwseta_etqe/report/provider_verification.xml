<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="action_report_provider_verification" model="ir.actions.report">
            <field name="name">Verification Report</field>
            <field name="model">provider.assessment</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">hwseta_etqe.report_provider_verification</field>
            <field name="report_file">hwseta_etqe.report_provider_verification</field>
            <field name="print_report_name">'Verification Report - %s' % (object.name)</field>
            <field name="binding_model_id" ref="model_provider_assessment"/>
            <field name="binding_type">report</field>
            <field name="groups_id" eval="[(4, ref('hwseta_etqe.group_etqe_manager')), 
                                          (4, ref('hwseta_etqe.group_etqe_executive_manager')), 
                                          (4, ref('hwseta_etqe.group_etqe_provincial_manager')), 
                                          (4, ref('hwseta_etqe.group_etqe_officer')), 
                                          (4, ref('hwseta_etqe.group_etqe_provincial_officer')), 
                                          (4, ref('hwseta_etqe.group_etqe_provincial_administrator')), 
                                          (4, ref('hwseta_etqe.group_etqe_administrator'))]"/>
