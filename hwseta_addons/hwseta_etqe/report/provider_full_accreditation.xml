<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <template id="report_provider_full_accreditation">
            <t t-call="web.html_container">
                <t t-call="hwseta_etqe.pro_ass_mod_header_footer_layout">
                    <t t-foreach="docs" t-as="o">
                        <div class="page" style="font-family: 'Arial Narrow', sans-serif;">
                            
                            <div class="row mt-4">
                                <div class="col-6">
                                    <p>
                                        <span t-esc="context_timestamp(datetime.datetime.now()).strftime('%d %B %Y')" />
                                    </p>
                                </div>
                                <div class="col-6 text-end">
                                    <p>
                                        Ref: <strong><span t-field="o.sequence_num" /></strong>
                                    </p>
                                </div>
                            </div>

                            <div class="mt-4">
                                <strong><span t-field="o.name" /></strong><br/>
                                <t t-if="o.street"><span t-field="o.street" />,</t>
                                <t t-if="o.street2"><span t-field="o.street2" /><br/></t>
                                <t t-if="o.street3"><span t-field="o.street3" />,</t><br/>
                                <t t-if="o.provider_suburb"><span t-field="o.provider_suburb" /><br/></t>
                                <t t-if="o.city"><span t-field="o.city" />,</t>
                                <t t-if="o.state_id"><span t-field="o.state_id" /></t><br/>
                                <t t-if="o.zip"><span t-field="o.zip" />,</t>
                                <t t-if="o.country_id"><span t-field="o.country_id" /></t>
                            </div>

                            <table class="table table-borderless table-sm mt-3" style="width: auto;">
                                <tr t-if="o.phone">
                                    <td>Telephone No.</td>
                                    <td><strong>:</strong></td>
                                    <td><span t-field="o.phone" /></td>
                                </tr>
                                <tr t-if="o.fax">
                                    <td>Fax</td>
                                    <td><strong>:</strong></td>
                                    <td><span t-field="o.fax" /></td>
                                </tr>
                                <tr t-if="o.email">
                                    <td>Email</td>
                                    <td><strong>:</strong></td>
                                    <td><span t-field="o.email" /></td>
                                </tr>
                            </table>

                            <p class="mt-3">
                                Dear 
                                <t t-foreach="o.provider_accreditation_contact_ids" t-as="provider_contact">
                                    <span t-field="provider_contact.name" /> <span t-field="provider_contact.sur_name" />,
                                </t>
                            </p>

                            <p class="mt-4"><strong>FULL ACCREDITATION AS A SKILLS DEVELOPMENT PROVIDER</strong></p>

                            <p>
                                The Health and Welfare Sector Education and Training Authority (HWSETA) is pleased to inform you that the full accreditation of 
                                <b><span t-field="o.name" /></b> is approved for the following learning programmes, which are aligned to NQF registered qualifications:
                            </p>

                            <t t-if="o.qualification_ids">
                                <table class="table table-bordered mt-3" style="page-break-inside: avoid;">
                                    <thead class="table-secondary text-center">
                                        <tr>
                                            <th colspan="6" style="background-color: #909090; color: white;">QUALIFICATIONS</th>
                                        </tr>
                                        <tr>
                                            <th rowspan="2" class="align-middle">QUALIFICATION TITLE</th>
                                            <th rowspan="2" class="align-middle">SAQA ID NO</th>
                                            <th rowspan="2" class="align-middle">NQF Level</th>
                                            <th colspan="3" style="background-color: #D3D3D3;">Approval Period</th>
                                        </tr>
                                        <tr style="background-color: #D3D3D3;">
                                            <th>Start Date</th>
                                            <th>Last date for Enrolment</th>
                                            <th>Last date for Achievement</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <t t-foreach="o.qualification_ids" t-as="data">
                                            <tr t-if="data.verify">
                                                <td><span t-field="data.qualification_id.name"/></td>
                                                <td class="text-center"><span t-field="data.saqa_qual_id"/></td>
                                                <td class="text-center"><span t-field="data.qualification_id.n_level"/></td>
                                                <td class="text-center"><span t-field="o.provider_approval_date" t-options='{"widget": "date"}'/></td>
                                                <td class="text-center"><span t-field="data.qualification_id.l_date_e" t-options='{"widget": "date"}'/></td>
                                                <td class="text-center"><span t-field="data.qualification_id.l_date_a" t-options='{"widget": "date"}'/></td>
                                            </tr>
                                            <t t-if="data.verify">
                                                <tr class="table-active text-center">
                                                    <th colspan="6">APPROVED ELECTIVE UNIT STANDARDS</th>
                                                </tr>
                                                <tr class="text-center" style="background-color: #D3D3D3;">
                                                    <td colspan="2"><strong>Title</strong></td>
                                                    <td><strong>SAQA ID</strong></td>
                                                    <td><strong>NQF Level</strong></td>
                                                    <td colspan="2"><strong>Credits</strong></td>
                                                </tr>
                                                <t t-foreach="data.qualification_line" t-as="line">
                                                    <tr t-if="line.selection and line.type == 'Elective'" class="text-center">
                                                        <td colspan="2"><span t-field="line.title"/></td>
                                                        <td><span t-field="line.id_no"/></td>
                                                        <td><span t-field="line.level2"/></td>
                                                        <td colspan="2"><span t-field="line.level3"/></td>
                                                    </tr>
                                                </t>
                                            </t>
                                        </t>
                                    </tbody>
                                </table>
                            </t>

                            <div class="mt-4" style="font-size: 0.9rem;">
                                <p><strong>You should be mindful of the last date of enrolment...</strong> (rest of text)</p>
                                <p>Your Accreditation Number is: <b><span t-field="o.sequence_num" /></b> and it is valid until 
                                <b><span t-field="o.reg_end_date" t-options='{"widget": "date", "format": "dd MMMM yyyy"}' /></b>.</p>
                                
                                <p>As an accredited Skills Development Provider, you are required to:</p>
                                <ol>
                                    <li>Attend the compulsory HWSETA Recognition of Prior Learning Capacity Building training/workshops;</li>
                                    <li>Attend the compulsory HWSETA information sharing workshops;</li>
                                    <li>Complete and submit the “Training Implementation Intent Form”...</li>
                                    <li>Keep learner records for a minimum of 5 (five) years;</li>
                                    </ol>
                            </div>

                            <div class="mt-5">
                                <p>Yours sincerely,</p>
                                <br/>
                                <p>_________________________<br/>
                                <strong>Ms Baakedi Jane Motubatse</strong><br/>
                                Executive Manager: ETQA</p>
                            </div>
                        </div>
                    </t>
                </t>
            </t>
        </template>
    </data>
</odoo>
