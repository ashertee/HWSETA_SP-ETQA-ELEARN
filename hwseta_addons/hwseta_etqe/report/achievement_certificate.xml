<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="paperformat_etqe_new" model="report.paperformat">
            <field name="name">ETQE</field>
            <field name="default" eval="True" />
            <field name="format">A4</field>
            <field name="page_height">0</field>
            <field name="page_width">0</field>
            <field name="orientation">Portrait</field>
            <field name="margin_top">70</field>
            <field name="margin_bottom">15</field>
            <field name="margin_left">7</field>
            <field name="margin_right">7</field>
            <field name="header_line" eval="False" />
            <field name="header_spacing">40</field>
            <field name="dpi">90</field>
        </record>

        <record id="achievement_certificate_id" model="ir.actions.report">
            <field name="name">Certificate of Achievement</field>
            <field name="model">provider.assessment</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">hwseta_etqe.report_achievement_certificate</field>
            <field name="report_file">hwseta_etqe.report_achievement_certificate</field>
            <field name="binding_model_id" ref="model_provider_assessment"/>
            <field name="binding_type">report</field>
            <field name="paperformat_id" ref="paperformat_etqe_new"/>
        </record>

