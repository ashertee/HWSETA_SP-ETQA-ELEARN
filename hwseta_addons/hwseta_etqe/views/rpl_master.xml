<record id="view_rpl_master_form" model="ir.ui.view">
    <field name="name">rpl.master.form</field>
    <field name="model">rpl.master</field>
    <field name="priority" eval="18" />
    <field name="arch" type="xml">
        <form string="RPL Master" create="false" delete="0" edit="0">
            <sheet>
                <field name="create_date" invisible="1"/>
                <div class="oe_title">
                    <label for="name" string="Practitioner Name"/>
                    <h1><field name="name" placeholder="e.g. John Smith"/></h1>
                </div>

                <group>
                    <group>
                        <field name="work_email" widget="email" required="1" readonly="1"/>
                        <field name="person_cell_phone_number" widget="phone" placeholder="0824513619"/>
                        <field name="reg_start" readonly="1"/>
                    </group>
                    <group>
                        <field name="is_rpl" invisible="1"/>
                        <field name="rpl_seq_no" invisible="not is_rpl" readonly="1"/>
                    </group>
                </group>

                <notebook>
                    <page name="popi" string="POPI Compliance">
                        <div class="alert alert-info" role="alert">
                            <strong>POPIA Terms and Conditions Disclaimer:</strong>
                            <field name="update_disclaimer" class="ms-2"/>
                        </div>
                    </page>

                    <page string="Public Information">
                        <group>
                            <group string="Work Address">
                                <div class="o_address_format">
                                    <field name="work_address" placeholder="Street Number" class="o_address_street" required="1"/>
                                    <field name="work_address2" placeholder="Street Name" class="o_address_street"/>
                                    <field name="work_address3" placeholder="Building/Office Park" class="o_address_street"/>
                                    <field name="person_suburb" placeholder="Suburb" class="o_address_street"/>
                                    <div class="d-flex">
                                        <field name="work_city" placeholder="City" class="o_address_city me-2"/>
<!--                                        <field name="work_province" placeholder="Province" class="o_address_state me-2" options="{'no_open': True}"/>-->
                                        <field name="work_zip" placeholder="ZIP" class="o_address_zip"/>
                                    </div>
                                    <field name="work_country" placeholder="Country" class="o_address_country" options="{'no_open': True}"/>
                                </div>
                            </group>
                            <group>
                                <field name="company_id" groups="base.group_multi_company"/>
                                <field name="user_id" string="Related User" readonly="1" invisible="1" />
                            </group>
                        </group>
                    </page>

                    <page string="Personal Details" invisible="not is_rpl">
                        <group>
                            <group string="Demographics">
                                <field name="person_title"/>
                                <field name="person_last_name"/>
                                <field name="person_name"/>
                                <field name="gender"/>
                                <field name="equity"/>
                                <field name="highest_education"/>
                            </group>
                            <group string="Citizenship">
                                <field name="citizen_resident_status_code"/>
                                <field name="identification_id" invisible="citizen_resident_status_code not in ['SA','D','PR']" required="citizen_resident_status_code in ['SA','D','PR']"/>
                                <field name="passport_id" invisible="citizen_resident_status_code == 'SA'"/>
                                <field name="home_language_code"/>
                            </group>
                        </group>
                    </page>

                    <page string="Address" name="rpl_address_tab" invisible="not is_rpl">
                        <group>
                            <group string="Home Address" name="home_address_group">
                                <label for="person_home_address_1" string="Home Address" />
                                <div class="o_address_format">
                                    <field name="person_home_address_1" placeholder="Street Number" required="1" class="o_address_street"/>
                                    <field name="person_home_address_2" placeholder="Street Name" class="o_address_street"/>
                                    <field name="person_home_address_3" placeholder="Building\Office Park" class="o_address_street"/>
                                    <field name="person_home_suburb" placeholder="Suburb" class="o_address_street"/>

                                    <div class="d-flex">
                                        <field name="person_home_city" placeholder="City" style="width: 40%"/>
                                        <field name="person_home_province_code" placeholder="Province Code"
                                               style="width: 40%" options="{'no_open': True}"/>
                                        <field name="person_home_zip" placeholder="ZIP" style="width: 20%"/>
                                    </div>

                                    <field name="country_home" placeholder="Country"
                                           options="{'no_open': True}" class="o_address_country"/>
                                </div>
                            </group>

                            <group string="Postal Address" name="postal_address_group">
                                <field name="same_as_home" string="Same as Home Address"/>

                                <label for="person_postal_address_1" string="Postal Address" invisible="same_as_home" />
                                <div class="o_address_format" invisible="same_as_home">
                                    <field name="person_postal_address_1" placeholder="Street Number"
                                           required="not same_as_home" class="o_address_street"/>
                                    <field name="person_postal_address_2" placeholder="Street Name" class="o_address_street"/>
                                    <field name="person_postal_address_3" placeholder="Building\Office Park" class="o_address_street"/>
                                    <field name="person_postal_suburb" placeholder="Suburb" class="o_address_street"/>

                                    <div class="d-flex">
                                        <field name="person_postal_city" placeholder="City" style="width: 40%"/>
                                        <field name="person_postal_province_code" placeholder="Province Code"
                                               style="width: 40%" options="{'no_open': True}"/>
                                        <field name="person_postal_zip" placeholder="ZIP" style="width: 20%"/>
                                    </div>

                                    <field name="country_postal" placeholder="Country"
                                           options="{'no_open': True}" class="o_address_country"/>
                                </div>
                            </group>
                        </group>
                    </page>

                    <page string="Documents" invisible="not is_rpl">
                        <group>
                            <field name="id_document" widget="binary"/>
                            <field name="rpl_certificate" widget="binary"/>
                            <field name="sram_doc" widget="binary"/>
                            <field name="cv_document" widget="binary"/>
                        </group>
                    </page>
                </notebook>
            </sheet>
            <chatter/>

        </form>

    </field>
</record>

<record id="view_rpl_master_form_inherit_readonly" model="ir.ui.view">
    <field name="name">view.rpl.master.form.readonly.assessors</field>
    <field name="model">rpl.master</field>
    <field name="inherit_id" ref="view_rpl_master_form" />
    <field name="arch" type="xml">
        <xpath expr="//field[@name='person_name']" position="attributes" groups="hwseta_etqe.group_assessors">
            <attribute name="readonly">1</attribute>
        </xpath>

        <xpath expr="//field[@name='gender']" position="attributes" groups="hwseta_etqe.group_assessors">
            <attribute name="readonly">1</attribute>
        </xpath>
    </field>
</record>

<record id="rpl_master_action" model="ir.actions.act_window">
    <field name="name">RPL Practitioner Database</field>
    <field name="res_model">rpl.master</field>
    <field name="view_mode">list,form</field>
    <field name="domain">[('is_rpl','=',True)]</field>
    <field name="context">{'default_is_rpl': 1}</field>
    <field name="view_id" ref="view_rpl_master_list" />
    <field name="search_view_id" ref="view_rpl_master_filter" />
    <field name="help" type="html">
        <p class="o_view_nocontent_smiling_face">
            No RPL Practitioners found.
        </p>
    </field>
</record>

